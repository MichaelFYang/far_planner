from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription
from launch.conditions import IfCondition
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration, PathJoinSubstitution
from launch_ros.actions import Node, SetParameter


def generate_launch_description():
    planner_share = get_package_share_directory('far_planner')
    config = LaunchConfiguration('config')

    return LaunchDescription([
        DeclareLaunchArgument('config', default_value='default'),
        DeclareLaunchArgument('use_sim_time', default_value='false'),
        DeclareLaunchArgument('use_rviz', default_value='true'),
        SetParameter(name='use_sim_time', value=LaunchConfiguration('use_sim_time')),
        Node(
            package='far_planner',
            executable='far_planner',
            name='far_planner',
            output='screen',
            parameters=[PathJoinSubstitution([
                planner_share, 'config', [config, '.yaml']
            ])],
            remappings=[
                ('/odom_world', '/state_estimation'),
                ('/terrain_cloud', '/terrain_map_ext'),
                ('/scan_cloud', '/terrain_map'),
                ('/terrain_local_cloud', '/registered_scan'),
            ],
        ),
        Node(
            package='rviz2',
            executable='rviz2',
            name='far_rviz',
            arguments=['-d', PathJoinSubstitution([
                planner_share, 'rviz', [config, '.rviz']
            ])],
            condition=IfCondition(LaunchConfiguration('use_rviz')),
        ),
        IncludeLaunchDescription(PythonLaunchDescriptionSource(
            PathJoinSubstitution([
                get_package_share_directory('graph_decoder'), 'launch', 'decoder.launch'
            ])
        )),
    ])
