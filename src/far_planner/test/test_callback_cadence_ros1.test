<launch>
  <node pkg="far_planner" type="far_planner" name="far_planner" output="screen">
    <param name="main_run_freq" value="2.5"/>
    <param name="sensor_time_tolerance" value="0.2"/>
    <param name="is_static_env" value="true"/>
    <param name="is_opencv_visual" value="false"/>
    <param name="is_pub_boundary" value="false"/>
    <param name="sensor_range" value="10.0"/>
    <param name="terrain_range" value="5.0"/>
    <param name="vehicle_height" value="0.75"/>
    <param name="MapHandler/map_grid_max_length" value="100.0"/>
    <param name="MapHandler/map_grad_max_height" value="10.0"/>
  </node>
  <test pkg="far_planner" type="test_callback_cadence_ros1.py"
        test-name="test_callback_cadence_ros1" time-limit="20"/>
</launch>
